@using NexusFlow.AppCore.Constants
@inject NexusFlow.AppCore.Interfaces.ICurrentUserService CurrentUser
@{ ViewData["Title"] = "Migration Centre"; }
<div id="migrationCentre" class="container-fluid pb-5"
     data-user="@CurrentUser.UserId"
     data-prepare="@CurrentUser.HasPermission(Permissions.Migration.Prepare).ToString().ToLowerInvariant()"
     data-approve="@CurrentUser.HasPermission(Permissions.Migration.Approve).ToString().ToLowerInvariant()"
     data-execute="@CurrentUser.HasPermission(Permissions.Migration.Execute).ToString().ToLowerInvariant()"
     data-finalize="@CurrentUser.HasPermission(Permissions.Migration.Finalize).ToString().ToLowerInvariant()">
    @Html.AntiForgeryToken()
    <div class="d-flex justify-content-between flex-wrap gap-3 mb-3"><div><h3 class="mb-1">Migration Centre</h3><p class="text-muted mb-0">One opening position. Upload everything together or complete selected scopes as data arrives.</p></div><a class="btn btn-outline-primary align-self-start" href="/api/migration/projects/templates">Download Template Pack</a></div>
    <div id="mcMessage" class="alert d-none" role="status" aria-live="polite"></div>
    <div class="card card-body mb-3"><div class="row g-3"><div class="col-md-8"><label class="form-label" for="mcProject">Saved migration project</label><select id="mcProject" class="form-select"><option value="">Choose a project</option></select></div><div class="col-md-4 d-flex align-items-end gap-2"><button id="mcNew" class="btn btn-primary" type="button">New Project</button><button id="mcRefresh" class="btn btn-outline-secondary" type="button">Refresh Progress</button></div></div><p id="mcProjectSummary" class="small mt-3 mb-0"></p></div>
    <form id="mcCreate" class="card card-body mb-3 d-none"><h5>Create migration project</h5><p>Enter the actual go-live date. The old system closing snapshot must be the previous evening, in Asia/Colombo. October activity stays in the old system until this switch; earlier history stays in the read-only archive.</p><div class="row g-3"><div class="col-md-4"><label for="mcName" class="form-label">Project name</label><input id="mcName" class="form-control" maxlength="120" required></div><div class="col-md-4"><label for="mcSource" class="form-label">Stable source system identifier</label><input id="mcSource" class="form-control" maxlength="80" required placeholder="LEGACY-ERP"></div><div class="col-md-4"><label for="mcOpening" class="form-label">Actual go-live opening date</label><input id="mcOpening" class="form-control" type="date" required></div></div>    <div class="small mb-3"><label for="mcAdoption" class="form-label">Existing customer batch adoption evidence (only when creating a project at the same original opening date)</label><input id="mcAdoption" class="form-control" placeholder="Leave blank for a fresh migration; existing batches and journals will be retained"></div><button class="btn btn-primary align-self-start mt-3" type="submit">Create Project</button></form>

    <div id="mcWorkspace" class="d-none">
        <div class="card card-body mb-3" aria-label="Project overview">
            <div id="mcOverview" class="row g-3"></div>
            <p id="mcNextAction" class="mt-3 mb-0 fw-semibold"></p>
        </div>
        <nav id="mcStages" class="mc-stages mb-3" aria-label="Migration stages"></nav>
        <section id="mcOperation" class="card card-body mb-3 d-none" aria-labelledby="mcOperationTitle">
            <h5 id="mcOperationTitle">Current operation</h5>
            <p id="mcOperationNotice" role="status" aria-live="polite"></p>
            <div id="mcOperationProgress"></div>
            <div id="mcOperationError" class="text-danger mt-2" role="alert"></div>
            <div class="d-flex gap-2 flex-wrap mt-2"><button id="mcResumeOperation" class="btn btn-outline-primary d-none" type="button">Retry / Resume unfinished work</button><button id="mcRetryStart" class="btn btn-outline-primary d-none" type="button">Retry start request</button><button id="mcUnresolved" class="btn btn-outline-primary d-none" type="button">View unresolved scopes</button></div>
            <details class="mt-2"><summary>Latest activity (20 items)</summary><ul id="mcActivity" class="small mt-2 mb-0"></ul></details>
        </section>
        <section data-stage="1" id="mcUploads" class="card card-body mb-3"><h5>1. Upload files</h5><p>CSV, values-only XLSX, or the supplied legacy XLS formats. Files are retained as evidence. Uploading creates staging rows; balances change only after approval and execution. Missing data stays <strong>Awaiting data</strong>.</p><form id="mcUpload"><div class="row g-3"><div class="col-md-4"><label for="mcModule" class="form-label">Dataset</label><select id="mcModule" class="form-select"></select></div><div class="col-md-5"><label for="mcFile" class="form-label">File, up to 20 MB</label><input id="mcFile" class="form-control" type="file" accept=".csv,.xls,.xlsx" required></div><div class="col-md-3 d-flex align-items-end"><button class="btn btn-primary" type="submit">Upload Dataset</button></div></div></form><form id="mcPackage" class="d-flex flex-wrap gap-2 mt-3"><label for="mcZip" class="align-self-center">Or upload a ZIP package with manifest.json</label><input id="mcZip" class="form-control w-auto" type="file" accept=".zip" required><button class="btn btn-outline-primary" type="submit">Upload Package</button></form><div id="mcUploadError" class="text-danger mt-2" role="alert"></div><div id="mcUploadProgress" class="mt-2" role="status" aria-live="polite"></div><div class="table-responsive mt-3"><table class="table table-sm"><thead><tr><th>Dataset</th><th>Revision</th><th>Closing date</th><th>Original file</th><th>Status</th></tr></thead><tbody id="mcFiles"></tbody></table></div></section>
        <section data-stage="2" id="mcMappings" class="card card-body mb-3"><h5>2. Map data</h5><p>Choose exact existing masters and posting accounts. Create any missing lookup, account, warehouse or bank branch in its master page first. Genuine blank contact details are allowed and flagged for completion.</p><div class="row g-3" id="mcDefaults"></div><hr><div class="row g-2"><div class="col-md-3"><label for="mcMapType" class="form-label">Mapping type</label><select id="mcMapType" class="form-select"></select></div><div class="col-md-3"><label for="mcLegacy" class="form-label">Exact legacy code</label><input id="mcLegacy" class="form-control" maxlength="100"></div><div class="col-md-4"><label for="mcTarget" class="form-label">NexusFlow master</label><select id="mcTarget" class="form-select"></select></div><div class="col-md-2 d-flex align-items-end"><button id="mcAddMap" class="btn btn-outline-primary" type="button">Add Mapping</button></div></div><div id="mcMapsFilters" class="mt-3"></div><div id="mcMapList" class="small mt-3"></div><div id="mcMapsPager"></div><div id="mcLocalMaps" class="small mt-2"></div><details class="mt-3"><summary>Change source column mapping</summary><div class="row g-2 mt-1"><div class="col-md-3"><label for="mcColumnModule" class="form-label">Dataset</label><select id="mcColumnModule" class="form-select"></select></div><div class="col-md-3"><label for="mcCanonical" class="form-label">Required field</label><select id="mcCanonical" class="form-select"></select></div><div class="col-md-4"><label for="mcSourceColumn" class="form-label">Source column</label><select id="mcSourceColumn" class="form-select"></select></div><div class="col-md-2 d-flex align-items-end"><button id="mcAddColumn" class="btn btn-outline-primary" type="button">Map Column</button></div></div><div id="mcColumnList" class="small mt-2"></div></details><hr><h6>Required data and zero declarations</h6><div id="mcDataStates" class="row g-3"></div><hr><div class="row g-3"><div class="col-md-6"><label for="mcSummaryStock" class="form-label">Summarized stock layer approval, if original FIFO layers are unavailable</label><textarea id="mcSummaryStock" class="form-control" rows="2" placeholder="Approval reference and explanation"></textarea></div><div class="col-md-6"><label for="mcFgValuation" class="form-label">Legacy finished goods valuation</label><select id="mcFgValuation" class="form-select"><option value="">Awaiting approved valuation / use corrected canonical stock file</option><option value="AverageCost">Average cost (avar × warehouse quantity)</option></select><label for="mcFgEvidence" class="form-label mt-2">Valuation discrepancy resolution evidence</label><textarea id="mcFgEvidence" class="form-control" rows="2"></textarea></div><div class="col-md-4"><label for="mcSupplierDays" class="form-label">Approved supplier terms in days (optional)</label><input id="mcSupplierDays" class="form-control" type="number" min="0" max="3650" placeholder="Use document due date"></div></div><div id="mcMappingsError" class="text-danger mt-2" role="alert"></div><button id="mcSaveMaps" class="btn btn-primary align-self-start mt-3" type="button">Save Mappings and Evidence</button></section>
        <section data-stage="3" id="mcSelection" class="card card-body mb-3"><h5>3. Validate and review</h5><p>Select modules. Leave code filters blank to include every code in those modules. A code selection always includes every opening row for that code; invoices are not cherry-picked. Other missing scopes can be completed later at the same closing date.</p><div id="mcModules" class="d-flex flex-wrap gap-3 mb-3"></div><div class="row g-3"><div class="col-md-3"><label for="mcCustomers" class="form-label">Customer codes</label><textarea id="mcCustomers" class="form-control" rows="2" placeholder="Comma or newline separated"></textarea></div><div class="col-md-3"><label for="mcSuppliers" class="form-label">Supplier codes</label><textarea id="mcSuppliers" class="form-control" rows="2"></textarea></div><div class="col-md-3"><label for="mcSkus" class="form-label">SKU codes</label><textarea id="mcSkus" class="form-control" rows="2"></textarea></div><div class="col-md-3"><label for="mcBanks" class="form-label">Bank account codes</label><textarea id="mcBanks" class="form-control" rows="2"></textarea></div></div><div id="mcValidateError" class="text-danger mt-2" role="alert"></div><button id="mcValidate" class="btn btn-primary align-self-start mt-3" type="button">Validate Selected Import</button></section>
        <section data-stage="3" id="mcReview" class="card card-body mb-3"><h5>Validation results</h5><div id="mcValidationFilters"></div><div id="mcValidationSummary" class="small mb-2"></div><div id="mcPreview"><p class="text-muted">Validate a selection to review normalized rows, errors and proposed journals.</p></div><div id="mcValidationPager"></div><div id="mcItemDetail" class="mt-3"></div><h6 class="mt-3">Validation errors and grouped warnings</h6><div id="mcIssueFilters"></div><div id="mcIssues"></div><div id="mcIssuesPager"></div><div id="mcIssueRows"></div></section>
        <section data-stage="4" id="mcProgress" class="card card-body mb-3"><h5>4. Approve and import</h5><label for="mcApprovalEvidence" class="form-label">Approval evidence</label><textarea id="mcApprovalEvidence" class="form-control" rows="2" placeholder="Closing reports, complete party positions, stock valuation and physical cheque verification reference"></textarea><div id="mcApproveError" class="text-danger mt-2" role="alert"></div><button id="mcApprove" class="btn btn-primary align-self-start mt-3" type="button" disabled>Approve Selected Import</button><p>Posting runs in the background. Each party or SKU commits atomically; a failed run retains completed work and resumes only unfinished work.</p><div id="mcImportError" class="text-danger mt-2" role="alert"></div><button id="mcExecute" class="btn btn-success align-self-start" type="button" disabled>Execute Approved Import</button><h6 class="mt-3">Operation history</h6><div id="mcHistoryFilters"></div><div id="mcHistory"></div><div id="mcHistoryPager"></div><h6 class="mt-3">Posting run history</h6><div id="mcRunsFilters"></div><div id="mcRuns" class="mt-3"></div><div id="mcRunsPager"></div><details class="mt-3"><summary>Posted units and unused-unit reversal</summary><div id="mcUnitsFilters"></div><div id="mcUnits"></div><div id="mcUnitsPager"></div></details></section>
        <section data-stage="5" id="mcScopes" class="card card-body mb-3"><h5>5. Reconcile and release</h5><div id="mcReleaseTotals" class="mb-2"></div><div id="mcScopeFilters"></div><div class="d-flex gap-2 flex-wrap mb-2"><button id="mcSelectPage" class="btn btn-sm btn-outline-secondary" type="button">Select pending on this page</button><button id="mcClearSelection" class="btn btn-sm btn-outline-secondary" type="button">Clear selection across pages</button><span id="mcSelectedCount" class="align-self-center small"></span></div><p>Pending scopes remain locked. Enter independently checked legacy totals and row counts before release. A full stock scope covers every warehouse. New-system entities need an evidenced <strong>No legacy opening</strong> classification.</p><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Select</th><th>Kind</th><th>Legacy code</th><th>State</th><th>Required components</th><th>Action</th></tr></thead><tbody id="mcScopeRows"></tbody></table></div><div id="mcScopesPager"></div><details><summary>Add a new-system scope</summary><form id="mcNewScope" class="row g-2 mt-1"><div class="col-md-2"><label for="mcScopeKind" class="form-label">Kind</label><select id="mcScopeKind" class="form-select"><option>Customer</option><option>Supplier</option><option>Stock</option><option>Bank</option></select></div><div class="col-md-3"><label for="mcScopeCode" class="form-label">Exact mapped code</label><input id="mcScopeCode" class="form-control" required></div><div class="col-md-5"><label for="mcScopeEvidence" class="form-label">Evidence: no legacy opening</label><input id="mcScopeEvidence" class="form-control" required></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-outline-primary" type="submit">Classify New Entity</button></div></form></details><div id="mcReconcile" class="mt-3"></div></section>
        <section data-stage="6" id="mcLedgerStage" class="card card-body mb-3"><h5>6. Trial Balance and ledger</h5><p>After releasing every opening scope, upload the complete closing Trial Balance in Upload files. Choose Trial Balance in Validate and review, then approve and import it. Its residual journal excludes post-go-live trading and cannot plug managed control differences.</p><button id="mcLedger" class="btn btn-outline-primary align-self-start" type="button">Check Full Ledger</button><div id="mcLedgerFilters" class="mt-3"></div><div id="mcLedgerResults" class="mt-3"></div><div id="mcLedgerPager"></div><div id="mcLedgerDetail" class="mt-2"></div></section>
        <section data-stage="7" id="mcFinal" class="card card-body mb-3"><h5>7. Final sign-off</h5><p>Finalization checks all financial data, every source row, released scopes and a zero difference for each account. The project then becomes read-only.</p><label for="mcFinalEvidence" class="form-label">Final financial sign-off evidence</label><textarea id="mcFinalEvidence" class="form-control" rows="2"></textarea><div id="mcFinalizeError" class="text-danger" role="alert"></div><button id="mcFinalize" class="btn btn-success align-self-start mt-3" type="button">Finalize Migration</button></section>
        <section data-stage="5" class="card card-body mb-3"><h5>Release pending scopes</h5><p>For a complete package or many selected parties, import a separate <strong>Control Totals</strong> schedule from the legacy closing reports. It must include every component's amount and row count, including zero components. Release selection is independent of the import modules. Selected scopes stay selected across pages; all matching uses the current kind and search, including other pages. A failed control leaves that scope pending.</p><p id="mcControlReadiness" class="fw-semibold"></p><label for="mcBulkEvidence" class="form-label">Signed independent schedule evidence</label><textarea id="mcBulkEvidence" class="form-control" rows="2"></textarea><div id="mcReleaseError" class="text-danger" role="alert"></div><div class="d-flex gap-2 flex-wrap mt-2"><button id="mcBulkRelease" class="btn btn-success" type="button">Release selected pending scopes</button><button id="mcReleaseAll" class="btn btn-outline-success" type="button">Release all matching pending scopes</button></div><div id="mcBulkResults" class="small mt-2"></div></section>
        <details data-stage="7" class="card card-body"><summary>Migration audit</summary><div id="mcAuditFilters" class="mt-2"></div><div id="mcAudit" class="small mt-3"></div><div id="mcAuditPager"></div></details>
    </div>
</div>
<style>
    .mc-stages { display: grid; grid-template-columns: repeat(auto-fit,minmax(120px,1fr)); gap: .5rem; }
    .mc-stages button { text-align: left; white-space: normal; min-height: 4rem; }
    #migrationCentre :focus-visible { outline: 3px solid var(--bs-primary); outline-offset: 3px; }
    #migrationCentre .mc-stage-state { display: block; font-size: .75rem; margin-top: .25rem; }
    #migrationCentre .mc-detail { border-left: 4px solid var(--bs-primary); padding: 1rem; background: var(--bs-tertiary-bg); }
    #migrationCentre .mc-preparing { width: 100%; }
    @@media (prefers-reduced-motion: reduce) { #migrationCentre * { animation: none !important; transition: none !important; scroll-behavior: auto !important; } }
</style>
@section Scripts { <script src="~/js/migration/centre.js" asp-append-version="true"></script> }
