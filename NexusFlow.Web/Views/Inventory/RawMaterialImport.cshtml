@{
    ViewData["Title"] = "Raw Material Import";
}
<div class="container-fluid py-3 mb-5">
    <h4>Raw Material Import</h4>
    <p class="text-muted">Create new non-sellable items and post their opening stock. Existing SKUs are never overwritten.</p>
    <div id="importMessage" class="alert d-none" role="status" aria-live="polite"></div>
    <form id="rawMaterialImportForm" class="card card-body shadow-sm mb-3">
        @Html.AntiForgeryToken()
        <fieldset id="importFields">
            <legend class="fs-6 fw-bold">1. File and import setup</legend>
            <p>CSV columns: <code>ProductName,SKU,Quantity,UnitCost</code>. Maximum 2 MB and 2,000 rows.
                <a href="/api/inventory/raw-material-import/template">Download example CSV</a> (replace the example row).</p>
            <div class="alert alert-info">The settings below apply to every row. Category, brand, unit, warehouse, date and ProductGroup columns in your CSV are ignored. Unit is always PCS. No selling price is required.</div>
            <div class="row g-3">
                <div class="col-md-6"><label for="importFile" class="form-label">CSV file</label>
                    <input id="importFile" name="File" type="file" accept=".csv,text/csv" class="form-control" required></div>
                <div class="col-md-3"><label for="importDate" class="form-label">Opening date</label>
                    <input id="importDate" name="OpeningDate" type="date" class="form-control" required></div>
                <div class="col-md-3"><label for="importWarehouse" class="form-label">Warehouse</label>
                    <select id="importWarehouse" name="WarehouseCode" class="form-select" required></select></div>
                <div class="col-md-4"><label for="importCategory" class="form-label">Category</label>
                    <input id="importCategory" name="CategoryName" class="form-control" value="Accessories" maxlength="100" required>
                    <div class="form-text">Created if missing, using configured accounts. Existing mappings must match.</div></div>
                <div class="col-md-4"><label for="importBrand" class="form-label">Brand</label>
                    <select id="importBrand" name="BrandName" class="form-select" required></select></div>
                <div class="col-md-4"><label for="importUnit" class="form-label">Unit</label>
                    <input id="importUnit" class="form-control" value="PCS (Pieces)" readonly></div>
            </div>
            <button id="previewImport" class="btn btn-primary mt-3" type="submit" disabled>Validate and Preview</button>
        </fieldset>
    </form>
    <section id="importPreview" class="card card-body shadow-sm d-none" aria-label="Import preview">
        <h5>2. Review and confirm</h5>
        <p id="importTotals" class="fw-bold"></p>
        <dl id="importMappings" class="row"></dl>
        <ul id="importWarnings" class="text-warning-emphasis"></ul>
        <div id="importErrors" class="alert alert-danger d-none"><h6>Fix these errors and preview again</h6><ul id="importErrorList"></ul></div>
        <div class="table-responsive mb-3" style="max-height: 420px">
            <table class="table table-striped table-sm"><thead><tr><th>CSV row</th><th>SKU</th><th>Name</th>
                <th class="text-end">Quantity</th><th class="text-end">Unit cost</th><th class="text-end">Value</th></tr></thead>
                <tbody id="importRows"></tbody></table>
        </div>
        <div class="form-check mb-3"><input id="confirmImport" class="form-check-input" type="checkbox">
            <label for="confirmImport" class="form-check-label">I confirm the quantities, unit costs (including values of 1), date and account mappings above. Post this opening stock.</label></div>
        <button id="postImport" class="btn btn-success align-self-start" type="button" disabled>Import and Post Opening Stock</button>
    </section>
    <a class="d-inline-block mt-3" href="/Inventory/OpeningStock">View Opening Stock</a>
</div>
@section Scripts {
    <script src="~/js/inventory/raw-material-import.js" asp-append-version="true"></script>
}
